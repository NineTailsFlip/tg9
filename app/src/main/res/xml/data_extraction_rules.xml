<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Android backup or device-to-device transfer: TDLib's database
     holds the signed-in Telegram session, and restoring it onto another device would hand that
     device the account. Settings travel through TG9's own Settings -> Backup instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
